# Blank credentials by design. Generate AGENT_API_KEY locally (minimum 16 characters).
AGENT_API_KEY=
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
# Required opt-in for OpenAI/OpenRouter or any non-loopback compatible endpoint.
ALLOW_REMOTE_LLM=false
# Compatible gateway capability: prompted (no tools/JSON mode), native, or tool.
# Official OpenAI adapter always uses Responses + native structured outputs.
LLM_OUTPUT_MODE=prompted
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=0.2
LLM_MAX_OUTPUT_TOKENS=12000
ANALYSIS_TIMEOUT_SECONDS=100
MAX_CONCURRENCY=4
QUEUE_TIMEOUT_SECONDS=1
BODY_TIMEOUT_SECONDS=10
MAX_REQUEST_BYTES=2000000
MAX_CONTENT_CHARS=150000
MAX_PAGES=50
MAX_SHEETS=10
MAX_ROWS=2000
MAX_CELLS=10000
MAX_FORM_NODES=5000
MAX_FORM_DEPTH=20
AMOUNT_TOLERANCE=0.02
# Optional administrator-only directory containing *_mapping.json and schema files.
# FORM_CONFIG_DIR=

# Authenticated in-memory XLSX preparation bounds.
MAX_XLSX_BYTES=5000000
MAX_XLSX_EXPANDED_BYTES=20000000
MAX_XLSX_ENTRIES=200
MAX_XLSX_COMPRESSION_RATIO=200
MAX_XLSX_XML_NODES=150000
MAX_XLSX_CONCURRENCY=2
XLSX_TIMEOUT_SECONDS=15
