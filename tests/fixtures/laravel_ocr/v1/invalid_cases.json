{
  "provenance": "Synthetic invalid AnalyzeRequest payloads, not provider responses.",
  "cases": [
    {
      "name": "empty_text",
      "request": {
        "document_id": "synthetic-invalid-ocr",
        "content": {
          "pages": [
            {
              "page": null,
              "text": ""
            }
          ]
        }
      },
      "expected_http_status": 422,
      "expected_error_code": "invalid_request"
    },
    {
      "name": "whitespace_only",
      "request": {
        "document_id": "synthetic-invalid-ocr",
        "content": {
          "pages": [
            {
              "page": null,
              "text": " \t\r\n  "
            }
          ]
        }
      },
      "expected_http_status": 422,
      "expected_error_code": "invalid_request"
    },
    {
      "name": "all_blank_pages",
      "request": {
        "document_id": "synthetic-invalid-ocr",
        "content": {
          "pages": [
            {
              "page": 3,
              "text": ""
            },
            {
              "page": 7,
              "text": "\n\t"
            }
          ]
        }
      },
      "expected_http_status": 422,
      "expected_error_code": "invalid_request"
    },
    {
      "name": "missing_text",
      "request": {
        "document_id": "synthetic-invalid-ocr",
        "content": {
          "pages": [
            {
              "page": 3
            }
          ]
        }
      },
      "expected_http_status": 422,
      "expected_error_code": "invalid_request"
    },
    {
      "name": "null_text",
      "request": {
        "document_id": "synthetic-invalid-ocr",
        "content": {
          "pages": [
            {
              "page": 3,
              "text": null
            }
          ]
        }
      },
      "expected_http_status": 422,
      "expected_error_code": "invalid_request"
    },
    {
      "name": "object_text",
      "request": {
        "document_id": "synthetic-invalid-ocr",
        "content": {
          "pages": [
            {
              "page": 3,
              "text": {
                "not": "a string"
              }
            }
          ]
        }
      },
      "expected_http_status": 422,
      "expected_error_code": "invalid_request"
    },
    {
      "name": "duplicate_unpaginated",
      "request": {
        "document_id": "synthetic-invalid-ocr",
        "content": {
          "pages": [
            {
              "page": null,
              "text": "x"
            },
            {
              "page": null,
              "text": "y"
            }
          ]
        }
      },
      "expected_http_status": 422,
      "expected_error_code": "invalid_request"
    },
    {
      "name": "contradictory_pagination",
      "request": {
        "document_id": "synthetic-invalid-ocr",
        "content": {
          "pages": [
            {
              "page": null,
              "text": "x"
            },
            {
              "page": 3,
              "text": "y"
            }
          ]
        }
      },
      "expected_http_status": 422,
      "expected_error_code": "invalid_request"
    },
    {
      "name": "duplicate_coerced_page_ids",
      "request": {
        "document_id": "synthetic-invalid-ocr",
        "content": {
          "pages": [
            {
              "page": "3",
